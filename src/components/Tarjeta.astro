---
import { evento } from '../data/evento.js';

const { precios, alias, whatsapp } = evento.tarjeta;
const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent('Hola! Te envío el comprobante de la tarjeta.')}`;
---

<section class="bg-arena px-6 py-20 text-center sm:py-24" data-reveal>
  <div class="mx-auto max-w-md">
    <p class="text-xs tracking-[0.3em] uppercase text-bronce">Tarjeta</p>
    <h2 class="mt-3 font-serif text-4xl text-tinta sm:text-5xl">Valor de la tarjeta</h2>

    <dl class="mt-8 divide-y divide-arena rounded-lg bg-crema/70 px-5 py-2 text-left">
      {
        precios.map(([condicion, precio]) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 py-3">
            <dt class="text-[0.65rem] tracking-[0.2em] uppercase text-tierra">{condicion}</dt>
            <dd class="font-serif text-xl text-tinta">{precio}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-8 text-base leading-relaxed text-tierra">Transferí al alias</p>
    <p class="mt-1 font-sans text-lg break-all text-tinta select-all">{alias}</p>

    {
      whatsapp && (
        <a
          href={waUrl}
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block rounded-full border border-bronce px-6 py-3 text-xs tracking-[0.2em] uppercase text-tinta"
        >
          Enviar comprobante por WhatsApp
        </a>
      )
    }
  </div>
</section>
