---
import { evento } from '../data/evento.js';

const { precios, alias, whatsapp, whatsappTexto } = evento.tarjeta;
const waUrl = `https://wa.me/${whatsapp}?text=${encodeURIComponent('Hola! Te envío el comprobante de la tarjeta.')}`;
---

<section class="bg-arena px-6 py-20 text-center sm:py-24" data-reveal>
  <div class="mx-auto max-w-md">
    <p class="text-xs tracking-[0.3em] uppercase text-bronce">Tarjeta</p>
    <h2 class="mt-3 font-serif text-4xl text-tinta sm:text-5xl">Valor de la tarjeta</h2>

    <dl class="mt-8 divide-y divide-arena rounded-lg bg-crema/70 px-5 py-2 text-left">
      {
        precios.map(([condicion, precio]) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 py-3">
            <dt class="text-[0.65rem] tracking-[0.2em] uppercase text-tierra">{condicion}</dt>
            <dd class="font-serif text-xl text-tinta">{precio}</dd>
          </div>
        ))
      }
    </dl>

    <p class="mt-8 text-base leading-relaxed text-tierra">Transferí al alias</p>
    <p class="mt-1 font-sans text-lg break-all text-tinta select-all">{alias}</p>

    {
      whatsapp && (
        <>
          <a
            href={waUrl}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center gap-2 rounded-full bg-tinta px-6 py-3 text-xs tracking-[0.2em] uppercase text-crema transition-colors hover:bg-bronce"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
            </svg>
            Enviar comprobante
          </a>
          <p class="mt-3 text-sm text-tierra">
            o al <span class="text-tinta select-all">{whatsappTexto}</span>
          </p>
        </>
      )
    }
  </div>
</section>
