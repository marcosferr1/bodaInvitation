---
import { evento } from '../data/evento.js';

const { mensaje, titular, alias, cbu, banco } = evento.regalos;

const datos = [
  ['Titular', titular],
  ['Alias', alias],
  ['CBU', cbu],
  ['Banco', banco],
];
---

<section class="bg-crema px-6 py-20 text-center sm:py-24" data-reveal>
  <div class="mx-auto max-w-md">
    <p class="text-xs tracking-[0.3em] uppercase text-bronce">Regalos</p>
    <h2 class="mt-3 font-serif text-4xl text-tinta sm:text-5xl">Si querés regalarnos algo</h2>
    <p class="mt-5 text-base leading-relaxed text-tierra">{mensaje}</p>

    <dl class="mt-8 divide-y divide-arena rounded-lg bg-arena/40 px-5 py-2 text-left">
      {
        datos.map(([label, valor]) => (
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 py-3">
            <dt class="text-[0.65rem] tracking-[0.2em] uppercase text-tierra">{label}</dt>
            <dd class="font-sans text-sm break-all text-tinta select-all">{valor}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
