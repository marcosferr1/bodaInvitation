---
import { evento } from '../data/evento.js';

const { codigo, detalle } = evento.vestimenta;
---

<section class="bg-crema px-6 py-20 text-center sm:py-24" data-reveal>
  <div class="mx-auto max-w-md">
    <p class="text-xs tracking-[0.3em] uppercase text-bronce">Dress code (mujeres)</p>
    <h2 class="mt-3 font-serif text-4xl text-tinta sm:text-5xl">{codigo}</h2>
    {detalle && <p class="mt-5 text-base leading-relaxed text-tierra">{detalle}</p>}
  </div>
</section>
